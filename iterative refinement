import os 
from openai import OpenAI 
# -------------------------------- 
# API Configuration 
# -------------------------------- 
api_key = os.environ.get("OPENAI_API_KEY") 
if not api_key: 
 raise ValueError("API key is not configured.") 
client = OpenAI(api_key=api_key) 
# -------------------------------- 
# Iteration 1 
# -------------------------------- 
prompt_1 = """ 
Summarize the plot of Romeo and Juliet. 
""" 
response_1 = client.responses.create( 
 model="YOUR_APPROVED_MODEL", 
 input=prompt_1 
) 
output_1 = response_1.output_text 
# -------------------------------- 
# Iteration 2 
# -------------------------------- 
prompt_2 = """ 
Summarize the plot of Romeo and Juliet in exactly two sentences. Use simple English and an academic style suitable for B.Tech students. """ 
response_2 = client.responses.create( 
 model="YOUR_APPROVED_MODEL", 
 input=prompt_2 
) 
output_2 = response_2.output_text 
# -------------------------------- 
# Iteration 3
# -------------------------------- 
prompt_3 = """ 
Summarize the plot of Romeo and Juliet in exactly two sentences. 
The summary must include: 
1. The main conflict between the two families. 
2. The setting of Verona. 
3. The relationship between Romeo and Juliet. 
4. The major theme of love and conflict. 
5. The tragic outcome of the story. 
""" 
response_3 = client.responses.create( 
 model="YOUR_APPROVED_MODEL", 
 input=prompt_3 
) 
output_3 = response_3.output_text 
# -------------------------------- 
# Display Results 
# -------------------------------- 
print("=" * 70) 
print("ITERATION 1 – MINIMAL PROMPT") 
print("=" * 70) 
print(output_1) 
print("\n") 
print("=" * 70) 
print("ITERATION 2 – LENGTH & STYLE CONSTRAINTS") 
print("=" * 70) 
print(output_2) 
print("\n") 
print("=" * 70) 
print("ITERATION 3 – SETTING, THEME & CONTENT REQUIREMENTS") print("=" * 70) 
print(output_3) 
