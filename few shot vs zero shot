import os 
from openai import OpenAI 
# ----------------------------------------- 
# API Configuration 
# ----------------------------------------- 
api_key = os.environ.get("OPENAI_API_KEY") 
if not api_key: 
 raise ValueError("API key is not configured.") 
client = OpenAI(api_key=api_key) 
# ========================================= # ZERO-SHOT PROMPT 
# ========================================= 
zero_shot_prompt = """ 
Classify the sentiment of each sentence as exactly one of: 
Positive, Negative, or Neutral. 
Return only the sentiment label for each sentence. 
Do not provide explanations. 
Sentences: 
1. The laboratory session was very interesting. 
2. The software installation failed several times. 
3. The class started at 10 AM. 
4. The teacher explained the experiment clearly. 
5. The computer stopped working during the experiment.
6. The students submitted the record on Thursday. """ 
response_zero = client.responses.create( 
 model="YOUR_APPROVED_MODEL", 
 input=zero_shot_prompt 
) 
zero_output = response_zero.output_text 
# ========================================= # FEW-SHOT PROMPT 
# ========================================= 
few_shot_prompt = """ 
Classify the sentiment of each sentence as exactly one of: Positive, Negative, or Neutral. 
Follow the classification pattern shown in the examples. 
Example 1: 
Input: The laboratory equipment is excellent. Output: Positive 
Example 2: 
Input: The computer stopped working during the class. Output: Negative 
Example 3: 
Input: The laboratory starts at 10 AM. 
Output: Neutral 
Now classify the following sentences. 
1. The laboratory session was very interesting. 2. The software installation failed several times. 3. The class started at 10 AM. 
4. The teacher explained the experiment clearly. 5. The computer stopped working during the experiment. 6. The students submitted the record on Thursday. 
Return only the sentiment labels. 
Do not provide explanations. 
""" 
response_few = client.responses.create( 
 model="YOUR_APPROVED_MODEL", 
 input=few_shot_prompt 
) 
few_output = response_few.output_text 
# =========================================
# DISPLAY RESULTS 
# ========================================= 
print("=" * 70) 
print("ZERO-SHOT PROMPT OUTPUT") 
print("=" * 70) 
print(zero_output) 
print("\n\n") 
print("=" * 70) 
print("FEW-SHOT PROMPT OUTPUT") 
print("=" * 70) 
print(few_output)
